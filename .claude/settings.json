{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew :sharedLogic:*)",
      "Bash(./gradlew :sharedUI:*)",
      "Bash(./gradlew :androidApp:*)",
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew ktlintFormat)",
      "Bash(./gradlew test)",
      "Bash(xcodebuild -project iosApp/iosApp.xcodeproj -scheme iosApp *)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./**/local.properties)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Bash(*local.properties*)",
      "Bash(*.env*)",
      "Bash(*.keystore*)",
      "Bash(*.jks*)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}

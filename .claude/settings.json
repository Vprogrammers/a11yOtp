{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew ktlintFormat)",
      "Bash(./gradlew test)",
      "Bash(./gradlew :androidApp:assembleDebug)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}
